# ============================================================
# Project GOAT — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in values as needed.
# NEVER commit .env or any file containing real credentials.
# ============================================================

# --- Data Directories ---
# GOAT_DATA_DIR=data
# GOAT_RAW_DATA_DIR=data/raw
# GOAT_PROCESSED_DATA_DIR=data/processed

# --- Logging ---
# GOAT_LOG_LEVEL=INFO

# --- Market Data Provider Settings (v0.2 Data Acquisition Only) ---
# GOAT_DERIV_WS_ENDPOINT=wss://ws.derivws.com/websockets/v3
# GOAT_DERIV_APP_ID=1089
# GOAT_COLLECTION_SYMBOLS=["R_10","R_50","R_75"]
# GOAT_RECONNECT_MAX_RETRIES=10
# GOAT_HEARTBEAT_INTERVAL=30.0

