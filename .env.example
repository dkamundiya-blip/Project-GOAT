# ============================================================
# Project GOAT — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in values as needed.
# NEVER commit .env or any file containing real credentials.
# ============================================================

# --- Data Directories ---
# GOAT_DATA_DIR=data
# GOAT_RAW_DATA_DIR=data/raw
# GOAT_PROCESSED_DATA_DIR=data/processed

# --- Logging ---
# GOAT_LOG_LEVEL=INFO

# --- Future: Market Data Provider Credentials ---
# These will be implemented in a later approved milestone.
# GOAT_PROVIDER_API_KEY=your_api_key_here
# GOAT_PROVIDER_API_SECRET=your_api_secret_here
# GOAT_PROVIDER_ENDPOINT=wss://example.com/ws
