# ============================================================
# Project GOAT — Git Ignore Rules
# ============================================================

# --- Credentials & Secrets (NEVER commit) ---
.env
*.key
*.pem

# --- Data (raw, processed, research, edge_reports, and campaigns are generated, not committed) ---
data/raw/
data/processed/
data/research/
data/campaigns/
data/edge_reports/
*.db
*.sqlite

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.eggs/

# --- Virtual Environments ---
venv/
.venv/
env/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/
.tox/

# --- Node.js & Frontend ---
node_modules/
**/node_modules/
**/dist/

